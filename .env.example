# ============================================================================
# Cloud AI Knowledge Assistant - environment configuration
#
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file - it is already listed in .gitignore.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# AWS credentials + S3
# Create an IAM user with a policy scoped ONLY to this one bucket
# (see README -> AWS Setup). Never use your root AWS account credentials.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# ---------------------------------------------------------------------------
# CloudWatch monitoring (optional - the app runs fine with this off)
# ---------------------------------------------------------------------------
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/cloud-ai-knowledge-assistant/app
CLOUDWATCH_LOG_STREAM=backend

# ---------------------------------------------------------------------------
# Qdrant Cloud
# Create a free cluster at https://cloud.qdrant.io and copy its URL + API key.
# ---------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=knowledge_assistant_chunks

# ---------------------------------------------------------------------------
# Embeddings (OpenAI) + LLM provider
# LLM_PROVIDER can be "openai" or "anthropic" - only the matching API key
# below needs to be filled in.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-latest

LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# RAG / retrieval tuning
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_SCORE_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Upload validation
# ---------------------------------------------------------------------------
ALLOWED_EXTENSIONS=.pdf
MAX_FILE_SIZE_MB=20

# ---------------------------------------------------------------------------
# Local document registry (status tracking - no external DB required)
# ---------------------------------------------------------------------------
DOCUMENTS_REGISTRY_PATH=data/documents_registry.json

# ---------------------------------------------------------------------------
# Frontend (Streamlit) - only used by frontend/streamlit_app.py
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
